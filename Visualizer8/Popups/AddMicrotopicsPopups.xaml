<?xml version="1.0" encoding="utf-8"?>
<mopups:PopupPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:mopups="clr-namespace:Mopups.Pages;assembly=Mopups"
             xmlns:viewModel="clr-namespace:Visualizer8.ViewModel"
             x:Class="Visualizer8.Popups.AddMicrotopicsPopups"
             x:DataType="viewModel:AddMicrotopicPopupModelView"
             Title="Add microtopic"
             BackgroundColor="#d3d2cd"
>
    <VerticalStackLayout
        VerticalOptions="Center"
        HorizontalOptions="Center"
    >
        <Border
            WidthRequest="600"
            HeightRequest="300"
            BackgroundColor="White"
        >
            <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center">
                <Label Text="Name:"
                       WidthRequest="500"
                       Margin="0, 10,0,0"
                ></Label>
                <Entry
                    Placeholder="Microtopic name"
                    Text="{Binding MicrotopicName}"
                    WidthRequest="500"
                />
                <Picker
                    Title="Unit:"
                    ItemsSource="{Binding Units}"
                    ItemDisplayBinding="{Binding 'Name'}"
                    SelectedItem="{Binding SelectedUnit}"
                    WidthRequest="500"
                    Margin="0, 10,0,0"
                    ></Picker>
                <Picker
                    Title="Topic:"
                    ItemsSource="{Binding Topics}"
                    ItemDisplayBinding="{Binding 'Name'}"
                    SelectedItem="{Binding SelectedTopic}"
                    WidthRequest="500"
                    Margin="0, 10,0,0"
                ></Picker>
                <Button
                    Command="{Binding onFormSubmittedCommand}"
                    Text="Save"
                    Margin="0, 10,0,0"
                ></Button>
            </VerticalStackLayout>
        </Border>
    </VerticalStackLayout>
</mopups:PopupPage>
